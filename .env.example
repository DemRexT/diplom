# Передайте переменные процессу сервера. Автоматического чтения .env нет.
# Выберите gigachat или yandex. Без LLM_PROVIDER код сохраняет прежний yandex.
LLM_PROVIDER=gigachat
# Ключ авторизации из личного кабинета GigaChat API (не временный access_token).
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# При необходимости: PEM-файл доверенного корневого сертификата/цепочки.
# Проверка TLS всегда включена.
# GIGACHAT_CA_BUNDLE=C:\certificates\trusted-ca.pem
# Настройки YandexGPT нужны только при LLM_PROVIDER=yandex.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
# Необязательно: по умолчанию SQLite в var/study.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/study
# На HTTPS обязательно включить secure-cookie
COOKIE_SECURE=0
# OCR для сканов PDF (движок Tesseract устанавливается отдельно)
OCR_LANG=rus+eng
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_TESSDATA_DIR=C:\path\to\tessdata
